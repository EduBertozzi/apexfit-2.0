# Copie para .env (que o git ignora) e preencha.
# Usadas SÓ pelas rotas de servidor /api/*. Nunca use o prefixo EXPO_PUBLIC_
# aqui: variáveis com esse prefixo vão para dentro do app e qualquer um extrai.
ANTHROPIC_API_KEY=

# IA local grátis (Ollama). Usada quando não há ANTHROPIC_API_KEY.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODELO=qwen2.5:7b

# OpenAI (API do ChatGPT). Usada quando não há ANTHROPIC_API_KEY.
# Funciona no servidor publicado: cadastre no EAS com
#   npx eas-cli env:create --name OPENAI_API_KEY --value <chave> --environment production --visibility secret
# e rode `npm run deploy`. Nunca use o prefixo EXPO_PUBLIC_.
OPENAI_API_KEY=
# Modelo (opcional). Padrão: gpt-6-luna. Ex: gpt-4o-mini
# OPENAI_MODELO=gpt-6-luna
# Esforço de raciocínio (opcional). Padrão "none" na família gpt-6; vazio não manda o campo.
# OPENAI_ESFORCO=none
